# Copy this file to .env and fill in real values.
# The Supabase anon key is safe to expose to the browser (Row Level Security
# protects the data) — this file just moves it out of source control so
# different environments (dev/staging/prod) can use different projects.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Public URL encoded into QR codes so phone cameras open the live site.
SITE_URL=https://weagri.netlify.app/

# Admin portal: log in from the normal login screen using this username
# (typed into the phone field) + password instead of a phone number.
ADMIN_USERNAME=kelvin Jeremiah
ADMIN_EMAIL=kelvin.jeremiah@admin.weagri.app

# Flat boost price (Instagram-style promotion), in each currency.
BOOST_TZS=50000
BOOST_USD=20

PORT=3000
